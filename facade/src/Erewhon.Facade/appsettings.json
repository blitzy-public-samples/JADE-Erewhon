{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Error"
    }
  },
  "Facade": {
    "RestPort": 65000,
    "SoapPort": 21001,
    "AdminPort": 9090,
    "BindAddress": "0.0.0.0",
    "WsdlPath": "contracts/wsdl/ErewhonWebService.wsdl"
  },
  "Backend": {
    "TimeoutSeconds": 30
  },
  "Routing": {
    "DefaultTarget": "backend",
    "Targets": {
      "backend": {
        "RestBaseUrl": "http://standin:65000",
        "SoapBaseUrl": "http://standin:21001"
      }
    },
    "Operations": {
      "Rest": {
        "getAgent": "backend",
        "getAllAgents": "backend",
        "getAllClients": "backend",
        "getAllSales": "backend",
        "getClient": "backend",
        "getCompany": "backend",
        "getItemByCode": "backend",
        "getItemsByPrice": "backend",
        "getSale": "backend",
        "postCreateAgent": "backend",
        "postCreateClient": "backend",
        "postCreateRetailSale": "backend",
        "postCreateTender": "backend"
      },
      "Soap": {
        "getAgent": "backend",
        "getAgentNames": "backend",
        "getClient": "backend",
        "getClientNames": "backend",
        "getPhoto": "backend",
        "updateAgent": "backend",
        "updateAgentWithDTO": "backend",
        "updateClient": "backend",
        "updateClientWithDTO": "backend"
      }
    }
  }
}
