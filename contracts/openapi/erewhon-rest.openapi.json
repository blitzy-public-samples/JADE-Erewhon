{
  "openapi": "3.1.1",
  "info": {
    "title": "Erewhon REST facade",
    "version": "1.0.0"
  },
  "paths": {
    "/agent/{pName}": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getAgent",
        "operationId": "getAgent",
        "parameters": [
          {
            "name": "pName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent found by exact name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOAgent"
                }
              }
            }
          },
          "404": {
            "description": "No agent with that exact name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    "/allAgents": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getAllAgents",
        "operationId": "getAllAgents",
        "responses": {
          "200": {
            "description": "All agents, in name order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOAgentArray"
                }
              }
            }
          }
        }
      }
    },
    "/allClients": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getAllClients",
        "operationId": "getAllClients",
        "responses": {
          "200": {
            "description": "All clients, in name order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOClientArray"
                }
              }
            }
          }
        }
      }
    },
    "/allSales": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getAllSales",
        "operationId": "getAllSales",
        "responses": {
          "200": {
            "description": "All sales, in (category prefix, code number) order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/DTORetailSale"
                      },
                      {
                        "$ref": "#/components/schemas/DTOTenderSale"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/client/{pName}": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getClient",
        "operationId": "getClient",
        "parameters": [
          {
            "name": "pName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Client found by name after trimming blanks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOClient"
                }
              }
            }
          },
          "404": {
            "description": "No client with the trimmed name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    "/company": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getCompany",
        "operationId": "getCompany",
        "responses": {
          "200": {
            "description": "Company exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOCompany"
                }
              }
            }
          },
          "500": {
            "description": "No company",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    "/createAgent": {
      "post": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.postCreateAgent",
        "operationId": "postCreateAgent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DTOAgent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Agent created; guid holds the new object's guid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOResult"
                }
              }
            }
          },
          "400": {
            "description": "AgentTA/AddressTA validation failed; allErrors holds the transaction-agent errors in order; The body is not a JSON object whose read members are strings or null (malformed JSON, invalid UTF-8, an empty body, a root other than an object, or a read member of another JSON kind), or a member name or read member's value holds an unpaired surrogate escape; rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DTOResult"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/createClient": {
      "post": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.postCreateClient",
        "operationId": "postCreateClient",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DTOClient"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Client created; guid holds the new object's guid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOResult"
                }
              }
            }
          },
          "400": {
            "description": "ClientTA/AddressTA validation failed; allErrors holds the transaction-agent errors in order; The body is not a JSON object whose read members are strings or null (malformed JSON, invalid UTF-8, an empty body, a root other than an object, or a read member of another JSON kind), or a member name or read member's value holds an unpaired surrogate escape; rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DTOResult"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/createRetailSale/{pClient}/{pCodePrefix}/{pCodeNumber}": {
      "post": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.postCreateRetailSale",
        "operationId": "postCreateRetailSale",
        "parameters": [
          {
            "name": "pClient",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pCodePrefix",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pCodeNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Retail sale created; guid holds the new object's guid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOResult"
                }
              }
            }
          },
          "400": {
            "description": "Item is not a RetailItem; allErrors holds $ItemNotRetailItem (\"Item is not a Retail Item\"); RetailSaleTA validation failed; allErrors holds the transaction-agent errors in order; pCodeNumber is not an Integer segment (for example 18.0 or 1e2); rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DTOResult"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No client with that exact name; allErrors holds $ClientNotFound (\"Client not found\"); No item with that code number; allErrors holds $ItemNotFound (\"Item was not found\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOResult"
                }
              }
            }
          }
        }
      }
    },
    "/createTender/{pClient}/{pCodePrefix}/{pCodeNumber}/{pOffer}": {
      "post": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.postCreateTender",
        "operationId": "postCreateTender",
        "parameters": [
          {
            "name": "pClient",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pCodePrefix",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pCodeNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pOffer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number",
              "description": "decimal"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Tender created; guid holds the new object's guid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOResult"
                }
              }
            }
          },
          "400": {
            "description": "Item is not a TenderItem; allErrors holds $ItemNotTenderItem (\"Item is not a Tender Item\"); TenderTA validation failed; allErrors holds the transaction-agent errors in order; pCodeNumber is not an Integer segment (for example 18.0 or 1e2), or pOffer not a Decimal segment (for example 1e7); rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DTOResult"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No client with that exact name; allErrors holds $ClientNotFound (\"Client not found\"); No item with that code number; allErrors holds $ItemNotFound (\"Item was not found\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTOResult"
                }
              }
            }
          }
        }
      }
    },
    "/itemByCode/{pCodePrefix}/{pCodeNumber}": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getItemByCode",
        "operationId": "getItemByCode",
        "parameters": [
          {
            "name": "pCodePrefix",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pCodeNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item found by code number; the prefix is validated but not used in the lookup",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DTORetailItem"
                    },
                    {
                      "$ref": "#/components/schemas/DTOTenderItem"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Code prefix empty or longer than 4 characters after trimming, or code number null; pCodeNumber is not an Integer segment (for example 18.0 or 1e2); rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          },
          "404": {
            "description": "No item with that code number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          },
          "500": {
            "description": "Item is neither a RetailItem nor a TenderItem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    "/itemsByPrice/{pMinPrice}/{pMaxPrice}": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getItemsByPrice",
        "operationId": "getItemsByPrice",
        "parameters": [
          {
            "name": "pMinPrice",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pMaxPrice",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items priced within the inclusive range, in code-number order; possibly empty",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/DTORetailItem"
                      },
                      {
                        "$ref": "#/components/schemas/DTOTenderItem"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Minimum below 0, maximum below 0, or maximum below minimum; pMinPrice or pMaxPrice is not an Integer segment (for example 18.0 or 1e2); rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    "/sale/{pCodePrefix}/{pCodeNumber}": {
      "get": {
        "tags": [
          "Erewhon.Facade"
        ],
        "summary": "ErewhonRestService.getSale",
        "operationId": "getSale",
        "parameters": [
          {
            "name": "pCodePrefix",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pCodeNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sale found by the untrimmed prefix and the code number",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DTORetailSale"
                    },
                    {
                      "$ref": "#/components/schemas/DTOTenderSale"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Code prefix empty or longer than 4 characters after trimming, or code number null; pCodeNumber is not an Integer segment (for example 18.0 or 1e2); rejected before the method body runs, with the literal null body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          },
          "404": {
            "description": "No sale for that prefix and code number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          },
          "500": {
            "description": "Sale is neither a RetailSale nor a TenderSale",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    }
  },
