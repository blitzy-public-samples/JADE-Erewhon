<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Erewhon.Api</RootNamespace>
    <AssemblyName>Erewhon.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Erewhon.Application/Erewhon.Application.csproj" />
    <ProjectReference Include="../Erewhon.Persistence/Erewhon.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="CoreWCF.Http" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
